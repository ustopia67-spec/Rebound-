function LoadCustomInstance(url, parent)
    local model

    while wait() and not model do
        print("🔄 Trying to load model from GitHub URL...")

        local success, result = pcall(function()
            local decoded = game:HttpGet(url)
            local tempPath = "temp_rebound_model.rbxm"
            writefile(tempPath, decoded)
            local loadedModel = game:GetObjects(getcustomasset(tempPath))[1]
            return loadedModel
        end)

        if success and result then
            model = result
            model.Parent = parent or workspace

            for _, obj in ipairs(model:GetDescendants()) do
                if obj:IsA("Script") or obj:IsA("LocalScript") then
                    obj:Destroy()
                end
            end

            pcall(function()
                model:SetAttribute("LoadedByExecutor", true)
            end)

            print("✅ [LoadCustomInstance]: Model " .. model.Name .. " successfully loaded into " .. model.Parent:GetFullName())
        else
            print("❌ [LoadCustomInstance]: Failed to load model from GitHub. Retrying... 🔄")
            wait(0.5)
        end
    end

    return model
end

function Move()
    local s = LoadCustomInstance("https://github.com/junin724/Depth/raw/refs/heads/main/rebound%20ultra%20new.rbxm", workspace)
    s.Parent = workspace
    local val = 60
    local killed = false
    local entity = s:FindFirstChild("Rebound")
    
    if not entity then
        warn("[Rebound] Entity not found in model. Aborting.")
        return
    end

    print("[Rebound] Entity found: Hello World!")

    local gruh = workspace.CurrentRooms
    local latestRoomVal = game.ReplicatedStorage.GameData.LatestRoom.Value

    -- Incrementa o contador de vai-e-vem a cada investida
    reboundCount = reboundCount + 1
    local directionType = (reboundCount % 2 == 1) and "ExitToEntrance" or "EntranceToExit"

    -- Define onde ele nasce com base na direção atual
    if directionType == "ExitToEntrance" then
        if gruh[latestRoomVal + 1] and gruh[latestRoomVal + 1]:FindFirstChild("RoomExit") then
            entity.CFrame = gruh[latestRoomVal + 1].RoomExit.CFrame
        end
    else
        if gruh[1] and gruh[1]:FindFirstChild("RoomEntrance") then
            entity.CFrame = gruh[1].RoomEntrance.CFrame
        end
    end

    task.wait(0.1)

    local function canSeeTarget(target, size)
        if killed then return false end
        local origin = entity.Position
        local direction = (target.HumanoidRootPart.Position - origin).unit * size
        local ray = Ray.new(origin, direction)
        local hit = workspace:FindPartOnRay(ray, entity)
        if hit and hit:IsDescendantOf(target) then
            killed = true
            return true
        end
        return false
    end

    wait(4)

    spawn(function()
        while entity ~= nil do 
            wait(0.5)
            local v = game.Players.LocalPlayer
            if v.Character and not v.Character:GetAttribute("Hiding") then
                if canSeeTarget(v.Character, 50) then
                    local ReboundJs = Instance.new("ScreenGui")
                    local Static = Instance.new("ImageLabel")
                    local Rebound = Instance.new("ImageLabel")
                    local JSSIZE = Instance.new("ImageLabel")

                    ReboundJs.Name = "ReboundJs"
                    ReboundJs.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

                    Static.Name = "Static"
                    Static.Parent = ReboundJs
                    Static.BackgroundTransparency = 1
                    Static.Size = UDim2.new(11, 0, 111, 0)
                    Static.Image = "rbxassetid://236543215"
                    Static.ImageTransparency = 1

                    Rebound.Name = "Rebound"
                    Rebound.Parent = ReboundJs
                    Rebound.BackgroundTransparency = 1
                    Rebound.Position = UDim2.new(0.4866, 0, 0.4793, 0)
                    Rebound.Size = UDim2.new(0.0267, 0, 0.0387, 0)
                    Rebound.Image = "rbxassetid://136184103476873"

                    JSSIZE.Name = "JSSIZE"
                    JSSIZE.Parent = ReboundJs
                    JSSIZE.BackgroundTransparency = 1
                    JSSIZE.Position = UDim2.new(-0.586, 0, -1.251, 0)
                    JSSIZE.Size = UDim2.new(2.128, 0, 3.081, 0)
                    JSSIZE.Visible = false
                    JSSIZE.Image = "rbxassetid://136184103476873"

                    local jumpscareSound = Instance.new("Sound")
                    jumpscareSound.SoundId = "rbxassetid://109582246349306"
                    jumpscareSound.Volume = 10
                    jumpscareSound.Parent = ReboundJs
                    jumpscareSound:Play()

                    coroutine.wrap(function()
                        local script = Static
                        while true do
                            script.Image = "rbxassetid://236543215"
                            task.wait(0.002)
                            script.Rotation = 0
                            task.wait(0.002)
                            script.Rotation = 180
                            task.wait(0.002)
                            script.Image = "rbxassetid://236777652"
                            task.wait(0.002)
                            script.Rotation = 0
                            task.wait(0.002)
                            script.Rotation = 180
                            task.wait(0.002)
                        end
                    end)()

                    coroutine.wrap(function()
                        local Plr = game.Players.LocalPlayer
                        local gui = ReboundJs
                        local static = gui.Static
                        local jspos = gui.JSSIZE

                        game.TweenService:Create(static, TweenInfo.new(0.5), {ImageTransparency = 0.8}):Play()
                        game.TweenService:Create(gui.Rebound, TweenInfo.new(0.5), {Size = jspos.Size, Position = jspos.Position}):Play()
                        task.spawn(function()
                            wait(0.3)
                            Plr.Character:FindFirstChildWhichIsA("Humanoid"):TakeDamage(100)
                            game.ReplicatedStorage.GameStats["Player_" .. Plr.Name].Total.DeathCause.Value = "Rebound"
                            game.ReplicatedStorage.Bricks.DeathHint.OnClientEvent:Fire({
                                "You died to who you call Rebound...",
                                "He makes his presence known and keeps coming back...",
                                "Hide when this happens!"
                            })
                        end)
                        wait(0.5)
                        game.TweenService:Create(static, TweenInfo.new(1), {ImageTransparency = 1}):Play()
                        game.TweenService:Create(gui.Rebound, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
                        wait(1)
                        gui:Destroy()
                    end)()
                end
            end
            if entity and (entity.Position - v.Character.HumanoidRootPart.Position).Magnitude <= val then
                camShake:Start()
                camShake:ShakeOnce(17, 6, 0.1, 1)
            end
        end
    end)

    -- Executa o movimento dependendo de qual direção ele começou
    if directionType == "ExitToEntrance" then
        for i = latestRoomVal, 1, -1 do
            if gruh:FindFirstChild(i) then
                local room = gruh[i]
                if room:FindFirstChild("RoomEntrance") then
                    local a = room.RoomEntrance
                    local tween = game.TweenService:Create(entity, TweenInfo.new(2, Enum.EasingStyle.Sine), {CFrame = a.CFrame})
                    tween:Play()
                    tween.Completed:Wait()
                    
                    local door = room:FindFirstChild("Door") or room:FindFirstChild("Doors")
                    local shouldPause = true
                    if door then
                        local lockedAttr = door:GetAttribute("Locked")
                        local openAttr = door:GetAttribute("Opened")
                        if lockedAttr == true or openAttr == false then
                            shouldPause = false
                        end
                    end

                    if shouldPause then
                        task.wait(0.1)
                    end
                end
            end
        end
    else
        for i = 1, latestRoomVal + 1 do
            if gruh:FindFirstChild(i) then
                local room = gruh[i]
                if room:FindFirstChild("RoomExit") then
                    local a = room.RoomExit
                    local tween = game.TweenService:Create(entity, TweenInfo.new(2, Enum.EasingStyle.Sine), {CFrame = a.CFrame})
                    tween:Play()
                    tween.Completed:Wait()
                    
                    local door = room:FindFirstChild("Door") or room:FindFirstChild("Doors")
                    local shouldPause = true
                    if door then
                        local lockedAttr = door:GetAttribute("Locked")
                        local openAttr = door:GetAttribute("Opened")
                        if lockedAttr == true or openAttr == false then
                            shouldPause = false
                        end
                    end

                    if shouldPause then
                        task.wait(0.1)
                    end
                end
            end
        end
    end

    entity.Anchored = false
    entity.CanCollide = false
    game.Debris:AddItem(s, 5)
end

function Rebound()
    local Warn = Instance.new("ColorCorrectionEffect", game.Lighting)
    Warn.TintColor = Color3.fromRGB(65, 138, 255)
    Warn.Saturation = -0.7
    Warn.Contrast = 0.2
    game.TweenService:Create(Warn, TweenInfo.new(15), {
        TintColor = Color3.fromRGB(255, 255, 255),
        Saturation = 0,
        Contrast = 0
    }):Destroy()

    camShake:Start()
    camShake:ShakeOnce(10, 3, 0.1, 6, 2, 0.5)
    pcall(Move)

    while maxRebounds > 0 do
        game.ReplicatedStorage.GameData.LatestRoom.Changed:Wait()
        wait(4)
        pcall(Move)
        maxRebounds = maxRebounds - 1
    end

    wait(15.3)
    Warn:Destroy()
end

pcall(Rebound)
warn("[Rebound] Fully Executed!")
require(game.Players.LocalPlayer.MainUI.Initiator.Main_Game).caption("thanks for using rebound script! ".. game.Players.LocalPlayer.Character.Name.. ".", 5)
